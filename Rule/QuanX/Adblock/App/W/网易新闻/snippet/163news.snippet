^https?:\/\/c\.m\.163\.com\/nc\/gl\/ url reject-200
^https?:\/\/gw\.m\.163\.com\/nc\/api\/v\d\/feed\/dynamic\/headline-list\? url script-response-body https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/163news.js
^https?:\/\/gw\.m\.163\.com\/nc\/api\/v\d\/search\/hot-word url script-response-body https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/163news.js
^https?:\/\/nex\.163\.com\/q url script-response-body https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/163news.js

hostname = c.m.163.com, gw.m.163.com, nex.163.com
