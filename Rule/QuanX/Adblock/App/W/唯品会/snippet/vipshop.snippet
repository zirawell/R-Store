#!name=唯品会 - VIPSHOP
#!desc=唯品会
#!openUrl=https://apps.apple.com/app/id417200582
#!bundleId=com.vipshop.iphone
#!author=zirawell[https://github.com/zirawell]
#!tag=去广告
#!basedOn=iOS
#!qx_version=1.5.2-854
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/QuanX/README.md
#!icon=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Icon/App/vipshop.png
#!date=2026-05-21

^https?:\/\/b\.appsimg\.com\/upload\/momin url reject
^https?:\/\/mapi\.appvipshop\.com\/vips-mobile\/rest\/activity\/advertisement\/get url reject-200
^https?:\/\/mapi\.appvipshop\.com\/vips-mobile\/rest\/iosAdInfo\/report url reject
# APP+小程序弹窗广告
^https?:\/\/mapi\.appvipshop\.com\/vips-mobile\/rest\/layout\/productList\/eventData\/v url reject-200
# 右下角悬浮窗，需手动关闭广告一次
^https?:\/\/mapi\.appvipshop\.com\/vips-mobile\/rest\/activity\/coupon\/float_entrance\/get\?api_key url reject-200
# 我的页瀑布流
^https?:\/\/mapi\.appvipshop\.com\/vips-mobile\/rest\/layout\/channel_b\/scene_data url reject
# 我的页悬浮窗
^https?:\/\/mapi\.appvipshop\.com\/vips-mobile\/rest\/activity\/float_ball\/get url reject

hostname = b.appsimg.com, mapi.appvipshop.com
