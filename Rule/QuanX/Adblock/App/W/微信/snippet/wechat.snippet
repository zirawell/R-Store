#!name=微信 - WECHAT
#!desc=微信
#!openUrl=https://apps.apple.com/app/id414478124
#!bundleId=com.tencent.xin
#!author=zirawell[https://github.com/zirawell]
#!tag=去广告
#!basedOn=iOS
#!qx_version=1.5.2-854
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/QuanX/README.md
#!icon=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Icon/App/wechat.png
#!date=2026-05-09

host, badjs.weixinbridge.com, reject
host, cube.weixinbridge.com, reject
host, dns.weixin.qq.com.cn, reject
host-suffix, wxs.qq.com, reject


^https?:\/\/dl\.wechat\.com\/checkresupdate url reject-dict
^https?:\/\/payapp\.weixin\.qq\.com\/mchopenapp\/goldplan\/adpage url reject
^https?:\/\/mp\.weixin\.qq\.com\/mp\/(?>ad_|advertisement|getappmsgad|cps_product_info|masonryfeed|relatedarticle|relatedsearchword|searchkeywordreport|geticon|getainfo|jsmonitor) url reject-dict
^https?:\/\/(weixin110\.qq|security.wechat)\.com\/cgi-bin\/mmspamsupport-bin\/newredirectconfirmcgi\? url script-response-body https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/Plugins/Wechat_Unblock_URL.js

hostname = dl.wechat.com, payapp.weixin.qq.com, mp.weixin.qq.com, weixin110.qq.com, security.wechat.com
