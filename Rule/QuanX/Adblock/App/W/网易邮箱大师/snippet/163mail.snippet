^https?:\/\/appconf\.mail\.163\.com\/mmad url reject-200
^https?:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/http\/urlConfig\.do$ url reject
^https?:\/\/client\.mail\.163\.com\/apptrack\/confinfo\/(?>searchMultiAds|showAds) url reject
^https?:\/\/support\.you\.163\.com\/xhr\/boot\/getBootMedia url reject

hostname = appconf.mail.163.com, client.mail.163.com, support.you.163.com
