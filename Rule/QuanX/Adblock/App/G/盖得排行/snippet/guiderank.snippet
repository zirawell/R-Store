^https?:\/\/zone\.guiderank-app\.com\/guiderank-web\/app\/ad\/listLaunchADByCity url reject
^https?:\/\/zone\.guiderank-app\.com\/guiderank-web\/app\/popUpAdCollection url reject-dict
^https?:\/\/zone\.guiderank-app\.com\/guiderank-web\/app\/common\/getWeworkPromotionInfoBySceneType url reject-dict
