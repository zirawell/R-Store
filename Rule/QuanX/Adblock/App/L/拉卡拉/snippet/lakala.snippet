#!name=拉卡拉 - LAKALA
#!desc=拉卡拉易分期-借钱借款贷款平台
#!openUrl=https://apps.apple.com/app/id523367437
#!bundleId=com.lakala.client
#!author=zirawell[https://github.com/zirawell]
#!tag=去广告
#!basedOn=iOS
#!qx_version=1.5.2-854
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/QuanX/README.md
#!icon=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Icon/App/lakala.png
#!date=2026-05-09

# 首页横幅+进货+借款广告
^https?:\/\/lamb\.lakala\.com\/lamo\/adv\/access\/queryMaterialUrl url reject-dict
# 补贴页面广告
^https?:\/\/wallet\.lakala\.com\/m\/lama\/mgt\/activity\/bank\/query\/list url reject-dict
# 私享定制广告
^https?:\/\/wallet\.lakala\.com\/m\/a\/lama\/mgt\/activity\/biz\/query\/byMerInfo url reject-dict
# 最新动态广告
^https?:\/\/wallet\.lakala\.com\/m\/a\/message\/v\d\/fetchMsgList url reject-dict

hostname = lamb.lakala.com, wallet.lakala.com
