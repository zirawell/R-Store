#!name=彩云天气 - CAIYUNAPP
#!desc=彩云天气-为您预报几点几分下雨
#!openUrl=https://apps.apple.com/app/id847764912
#!bundleId=net.colorfulclouds.app
#!author=zirawell[https://github.com/zirawell]
#!tag=去广告
#!basedOn=iOS
#!qx_version=1.5.2-854
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/QuanX/README.md
#!icon=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Icon/App/caiyunapp.png
#!date=2026-01-22

host, ad.cyapi.cn, reject
host, gather.colorfulclouds.net, reject


# 移除小助手
^https?:\/\/wrapper\.cyapi\.cn\/v\d\/activity\?.*type_id=A03 url jsonjq-response-body '.activities[]? |= (if .feature != null then .feature = false else . end)'
# 移除搜索内的推广
^https?:\/\/starplucker\.cyapi\.cn\/v\d\/config url jsonjq-response-body 'del(.search_suggestions)?'
# 移除广告和推广
^https?:\/\/starplucker\.cyapi\.cn\/v\d\/config url jsonjq-response-body '(.pic_page_card_orders[]?, .map_page_card_orders[]?) |= select(.name | test("^(A|C01)") | not)'

hostname = wrapper.cyapi.cn, starplucker.cyapi.cn
