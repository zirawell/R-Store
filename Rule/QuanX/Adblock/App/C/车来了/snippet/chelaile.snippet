host, atrace.chelaile.net.cn, reject
host, logs.chelaile.net.cn, reject
host, ad.chelaile.net.cn, reject


^https?:\/\/pic\d\.chelaile\.net\.cn\/adv\/ url reject
^https?:\/\/(api|atrace)\.chelaile\.net\.cn\/adpub url reject
^https?:\/\/api\.chelaile\.net\.cn\/goocity\/advert url reject
^https?:\/\/atrace\.chelaile\.net\.cn\/exhibit\?&adv_image url reject-img
^https?:\/\/web\.chelaile\.net\.cn\/api\/adpub url reject
^https?:\/\/cdn\.\w{3}\.chelaileapp\.cn\/(api\/)?adpub url reject

hostname = pic*.chelaile.net.cn, api.chelaile.net.cn, atrace.chelaile.net.cn, web.chelaile.net.cn, cdn.*.chelaileapp.cn
