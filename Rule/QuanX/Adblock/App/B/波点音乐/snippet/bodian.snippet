#!name=波点音乐 - BODIAN
#!desc=波点音乐
#!openUrl=https://apps.apple.com/app/id1541981555
#!bundleId=com.wenyu.bodian
#!author=zirawell[https://github.com/zirawell]
#!tag=去广告
#!basedOn=iOS
#!qx_version=1.5.2-854
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/QuanX/README.md
#!icon=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Icon/App/bodian.png
#!date=2026-05-09

^https?:\/\/bd-api\.kuwo\.cn\/api\/(\w+\/)?advert url reject-dict
^https?:\/\/bd-api\.kuwo\.cn\/api\/.*popup url reject-dict
^https?:\/\/bd-api\.kuwo\.cn\/api\/pay\/vip\/lowPriceText url reject-dict
^https?:\/\/bd-api\.kuwo\.cn\/api\/play\/listening\/entrance\/music\?musicId url reject-dict
^https?:\/\/bd-api\.kuwo\.cn\/api\/search\/topic\/word\/list url reject-dict
^https?:\/\/bd-api\.kuwo\.cn\/api\/service\/banner url reject-dict
^https?:\/\/bd-api\.kuwo\.cn\/api\/service\/finds\/module url reject-dict
^https?:\/\/bd-api\.kuwo\.cn\/api\/service\/global\/config\/vipEnter url reject-dict
^https?:\/\/bd-api\.kuwo\.cn\/api\/service\/global\/config\/scene url jsonjq-response-body '.data.showShopEntry=false|.data.idolTabShow=true'
^https?:\/\/bd-api\.kuwo\.cn\/api\/service\/music\/recommendList url jsonjq-response-body '.data.musicList[] |= del(.showAd)'
^https?:\/\/bd-api\.kuwo\.cn\/api\/service\/resource\/recommend url jsonjq-response-body '.data.resourceList[] |= del(.resource)'
^https?:\/\/bd-api\.kuwo\.cn\/api\/voice\/room\/v\d\/sidebar url jsonjq-response-body '(.data) = {}'

hostname = bd-api.kuwo.cn
