^https?:\/\/mage(v\d)?\.if\.qidian\.com\/argus\/api\/v\d\/adv url reject
^https?:\/\/mage(v\d)?\.if\.qidian\.com\/argus\/api\/v\d\/booksearch\/hotWords url reject
^https?:\/\/mage(v\d)?\.if\.qidian\.com\/argus\/api\/v\d\/bookshelf\/get(?>ad|TopOperation) url reject
^https?:\/\/mage(v\d)?\.if\.qidian\.com\/argus\/api\/v\d\/client\/(?>getsplashscreen|iosad) url reject
^https?:\/\/mage(v\d)?\.if\.qidian\.com\/argus\/api\/v\d\/dailyrecommend\/recommendBook url reject
^https?:\/\/mage(v\d)?\.if\.qidian\.com\/argus\/api\/v\d\/followsubscribe url reject-dict
^https?:\/\/mage(v\d)?\.if\.qidian\.com\/argus\/api\/v\d\/freshman\/bookshelfbtn url reject
^https?:\/\/mage(v\d)?\.if\.qidian\.com\/argus\/api\/v\d\/maintain\/playstrip$ url reject
^https?:\/\/mage(v\d)?\.if\.qidian\.com\/argus\/api\/v\d\/message\/getpushedmessagelist$ url reject
^https?:\/\/mage(v\d)?\.if\.qidian\.com\/argus\/api\/v\d\/push\/getdialog url reject
^https?:\/\/mage(v\d)?\.if\.qidian\.com\/argus\/api\/v\d\/young\/getconf$ url reject
^https?:\/\/mage(v\d)?\.if\.qidian\.com\/argus\/api\/v\d\/(deeplink\/geturl|client\/getconf|bookshelf\/getHoverAdv|dailyrecommend\/getdailyrecommend|assembly\/toolbar|user\/getaccountpage) url script-response-body https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/qidian.js

hostname = mage.if.qidian.com, magev*.if.qidian.com
