#!name=Youtube (Music) Enhance - YOUTUBE
#!desc=适用于 Youtube & Youtube Music
#!openUrl=https://apps.apple.com/app/id544007664
#!bundleId=com.google.ios.youtube
#!author=zirawell[https://github.com/zirawell]
#!tag=去广告
#!basedOn=iOS
#!qx_version=1.5.2-854
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/QuanX/README.md
#!icon=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Icon/App/youtube.png
#!source=https://raw.githubusercontent.com/Maasea/sgmodule/refs/heads/master/YouTube.Enhance.sgmodule

host, ads.youtube.com, reject
host, s.youtube.com, reject


# ⚠️Quantumult X 必须在 [general] 部分加入以下代码: udp_drop_list=443
^https?:\/\/rr[\w-]+\.googlevideo\.com\/initplayback\? url reject-dict
^https?:\/\/youtubei\.googleapis\.com\/(youtubei\/v\d\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch))(\?(.*))?$ url script-response-body https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/youtube.js

hostname = rr*.googlevideo.com, youtubei.googleapis.com
