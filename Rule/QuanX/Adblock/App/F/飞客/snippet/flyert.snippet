^https?:\/\/www\.flyert(rip)?\.com(\.cn)?\/.*\.php\?module=advis url reject-dict
^https?:\/\/www\.flyert(rip)?\.com(\.cn)?\/.*\.php\?module=basicdata&type=appinfo url reject-dict
^https?:\/\/www\.flyert(rip)?\.com(\.cn)?\/.*\.php\?.*module=basicdata&type=forumlist url response-body adv response-body adv0
^https?:\/\/www\.flyert(rip)?\.com(\.cn)?\/.*\.php\?.*module=threadpost url response-body relatedrecommend response-body relatedrecommend0
