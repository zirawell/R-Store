# 屏蔽更新
^https?:\/\/\w+\.juneyaoair\.com(\/server)?\/version url reject-200
^https?:\/\/\w+\.juneyaoair\.com(\/server)?\/data\/index\/(?>queryPopUpWinPic|getLoadPic|getRecommendProduct|creditCardAd) url reject
^https?:\/\/\w+\.juneyaoair\.com(\/server)?\/data\/index\/getPictureList url script-response-body https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/juneyaoair.js
^https?:\/\/shopping\.juneyaoair\.com\/mobile\/shop\/mobile\/app url response-body "index_pop_wap_enable":true response-body "index_pop_wap_enable":false

hostname = hoapp.juneyaoair.com, m.juneyaoair.com, shopping.juneyaoair.com
