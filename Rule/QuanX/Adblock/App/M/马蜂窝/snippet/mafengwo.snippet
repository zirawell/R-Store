#!name=马蜂窝 - MAFENGWO
#!desc=马蜂窝-全球旅游攻略,旅行度假酒店预订
#!openUrl=https://apps.apple.com/app/id406596432
#!bundleId=cn.mafengwo.www
#!author=zirawell[https://github.com/zirawell]
#!tag=去广告
#!basedOn=iOS
#!qx_version=1.5.2-854
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/QuanX/README.md
#!icon=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Icon/App/mafengwo.png
#!date=2026-05-09

host-suffix, advert.mafengwo.cn, reject


^https?:\/\/mapi\.mafengwo\.cn\/(travelguide\/)?ad url reject
^https?:\/\/mapi\.mafengwo\.cn\/widget\/note\/get_widget_note url reject
^https?:\/\/mapi\.mafengwo\.cn\/system\/update\/check_update url reject-dict
^https?:\/\/mapi\.mafengwo\.cn\/system\/config\/(?>get|mark)_(?>push|alert)_config url reject-dict
^https?:\/\/mapi\.mafengwo\.cn\/system\/push\/get_local_push_config url reject
^https?:\/\/mapi\.mafengwo\.cn\/user\/profile\/get_(?>list|profile) url script-response-body https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/mafengwo.js

hostname = mapi.mafengwo.cn
