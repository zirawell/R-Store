[Rule]
DOMAIN, api.htp.ad-scope.com.cn, REJECT, extended-matching, pre-matching
DOMAIN, init.sms.mob.com, REJECT, extended-matching, pre-matching

[Map Local]
^https?:\/\/app(\w+)?\.ddpai\.com(:\d+)?\/onroad\/api\/v\d\/(?>ad|banner|news)\/list data-type=json data="{}" status-code=200

[MITM]
hostname= %APPEND% app*.ddpai.com