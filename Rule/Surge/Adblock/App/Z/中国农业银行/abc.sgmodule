#!author=zirawell[https://github.com/zirawell]
#!tag=去广告
#!basedOn=iOS
#!surge_version=5.14.2(Build3405,SDK18.2)
#!homepage=https://github.com/zirawell/R-Store/tree/main/Rule/Surge/README.md
#!icon=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Icon/App/abc.png
#!date=2026-10-29

[Rule]
DOMAIN, imc.abchina.com.cn, REJECT, extended-matching, pre-matching
DOMAIN, apm.abchina.com.cn, REJECT, extended-matching, pre-matching
DOMAIN, msmp.abchina.com.cn, REJECT, extended-matching, pre-matching
DOMAIN, firefly.abchina.com.cn, REJECT, extended-matching, pre-matching

[Map Local]
# ⚠️域名[mobilepaas.abchina.com.cn]已无法MITM，可能会导致App端部分功能无法使用，请自行选择是否需要
^https?:\/\/mall\.abchina\.com\.cn\/pips\/EbizccmClientServer\/PIPSPopupAdvertisement data-type=json data="{}" status-code=200

[Script]
;abc = type=http-response,pattern=^https?:\/\/mobilepaas\.abchina\.com\.cn(:441)?\/mgw\.htm$,requires-body=0,max-size=0,script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/mgw.js

[MITM]
hostname= %APPEND% mall.abchina.com.cn