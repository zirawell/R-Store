[Map Local]
^https?:\/\/edata\.bank\.ecitic\.com\/mobile\/collect\.do data-type=json data="{}" status-code=200

[Script]
ecitic = type=http-request,pattern=^https?:\/\/autoload\.bank\.ecitic\.com\/imcslego\/cloud\/\w+\.jpg\?,requires-body=0,max-size=0,script-path=https://raw.githubusercontent.com/zirawell/R-Store/main/Res/Scripts/AntiAd/ecitic.js

[MITM]
hostname= %APPEND% edata.bank.ecitic.com, autoload.bank.ecitic.com